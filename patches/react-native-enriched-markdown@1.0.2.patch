+    CGFloat x = kChipHorizontalPadding;
+    if (symbol) {
+      [symbol drawInRect:CGRectMake(x - insets.left, (height - glyph.height) / 2 - insets.top, symbol.size.width,
+                                    symbol.size.height)];
