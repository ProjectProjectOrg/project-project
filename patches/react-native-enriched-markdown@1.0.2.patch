+  CGSize textSize = [text sizeWithAttributes:textAttributes];
+  UIImage *symbol =
+      symbolURL ? ENRMSymbolImage(symbolURL, [UIImageSymbolConfiguration
+                                                 configurationWithPointSize:font.pointSize * kChipSymbolScale
+                                                                     weight:UIImageSymbolWeightRegular])
+                : nil;
+  UIEdgeInsets insets = symbol ? symbol.alignmentRectInsets : UIEdgeInsetsZero;
+  CGSize glyph = symbol ? CGSizeMake(symbol.size.width - insets.left - insets.right,
+                                     symbol.size.height - insets.top - insets.bottom)
+                        : CGSizeZero;
