+#import <Foundation/Foundation.h>
+
+// The outer columns sit flush with the table's edges, so the text lines up with the paragraphs around it
+static inline CGFloat ENRMTableCellLeadingPadding(NSUInteger column, CGFloat padding)
+{
+  return column == 0 ? 0 : padding;
+}
+
+static inline CGFloat ENRMTableCellTrailingPadding(NSUInteger column, NSUInteger columnCount, CGFloat padding)
+{
+  return column + 1 == columnCount ? 0 : padding;
+}
