+// A link drawn as a chip, like a native capsule button: one inline image, centred on the text's cap height
+static NSAttributedString *ENRMChipString(NSAttributedString *label, UIColor *textColor, UIColor *fillColor)
+{
+  __block NSString *symbolURL = nil;
+  __block UIFont *baseFont = nil;
+  [label enumerateAttributesInRange:NSMakeRange(0, label.length)
+                            options:0
+                         usingBlock:^(NSDictionary<NSAttributedStringKey, id> *attrs, NSRange range, BOOL *stop) {
+                           if (attrs[ENRMSymbolURLAttributeName])
+                             symbolURL = attrs[ENRMSymbolURLAttributeName];
+                           else if (attrs[NSFontAttributeName])
+                             baseFont = attrs[NSFontAttributeName];
+                         }];
+  NSString *text = [[label.string stringByReplacingOccurrencesOfString:@"\uFFFC" withString:@""]
+      stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceCharacterSet];
