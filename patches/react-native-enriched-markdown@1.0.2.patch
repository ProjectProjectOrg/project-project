+static UIColor *ENRMColorFromHex(NSString *hex)
+{
+  NSString *digits = [hex hasPrefix:@"#"] ? [hex substringFromIndex:1] : hex;
+  if (digits.length != 6)
+    return nil;
+  unsigned int value = 0;
+  if (![[NSScanner scannerWithString:digits] scanHexInt:&value])
+    return nil;
+  return [UIColor colorWithRed:((value >> 16) & 0xFF) / 255.0
+                         green:((value >> 8) & 0xFF) / 255.0
+                          blue:(value & 0xFF) / 255.0
+                         alpha:1.0];
+}
+
+NSString *const ENRMSymbolURLAttributeName = @"ENRMSymbolURL";
+
+// sf:<symbol name>?color=<hex> names an SF Symbol and its tint
+UIImage *_Nullable ENRMSymbolImage(NSString *url, UIImageSymbolConfiguration *configuration)
+{
+  NSURLComponents *components = [NSURLComponents componentsWithString:url];
+  NSString *name = components.path;
+  if (name.length == 0)
+    return nil;
+  UIColor *color = nil;
+  for (NSURLQueryItem *item in components.queryItems) {
+    if ([item.name isEqualToString:@"color"])
+      color = ENRMColorFromHex(item.value);
+  }
+  UIImage *symbol = [UIImage systemImageNamed:name withConfiguration:configuration];
+  if (symbol && color)
+    symbol = [symbol imageWithTintColor:color renderingMode:UIImageRenderingModeAlwaysOriginal];
+  return symbol;
+}
+
+// Made for the surrounding font, so TextKit aligns it like text
+static NSAttributedString *ENRMSymbolString(NSString *url, UIFont *font)
+{
+  UIImage *symbol = ENRMSymbolImage(
+      url, [UIImageSymbolConfiguration configurationWithFont:font scale:UIImageSymbolScaleSmall]);
+  if (!symbol)
+    return nil;
+  NSMutableAttributedString *string =
+      [[NSAttributedString attributedStringWithAttachment:[NSTextAttachment textAttachmentWithImage:symbol]] mutableCopy];
+  NSRange all = NSMakeRange(0, string.length);
+  [string addAttribute:NSFontAttributeName value:font range:all];
+  [string addAttribute:ENRMSymbolURLAttributeName value:url range:all];
+  return string;
+}
+
