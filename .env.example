# Copy to `.env` and fill in. `.env` is gitignored; `.env.example` is not.
#
# Bun loads `.env` automatically when it starts (no dotenv package needed).
# Effect's `Config` module reads `process.env` to resolve `Config.redacted(...)`
# values — see packages/backend/src/services/Db.ts.

# --- Database ---------------------------------------------------------------
# Connection string for the local Postgres instance run by docker-compose.
# The credentials match docker-compose.yml; change both together if you do.
#
# On Windows + Docker Desktop, prefer `host.docker.internal` over `localhost`.
# Docker Desktop's port-forwarding proxy on Windows mangles the SCRAM-SHA-256
# handshake bytes on the localhost:5432 path; `host.docker.internal` routes
# through a different mechanism and works. macOS Docker Desktop accepts both.
# On native Linux, use `localhost` (host.docker.internal isn't always defined).

# Database related variables
DATABASE_URL=postgres://projectproject:projectproject_dev@host.docker.internal:5432/projectproject

# Auth related variables
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BETTER_AUTH_SECRET=

# GitHub App related variables. This is separate from the personal GitHub OAuth
# app above: the OAuth app links a user's personal GitHub account, while this
# GitHub App installs onto an organization and powers org/project repo reads.
#
# Register the GitHub App with:
#   Setup URL:    http://localhost:5173/api/integrations/github/setup
#   Callback URL: http://localhost:5173/api/integrations/github/callback
#   Webhook URL:  a public tunnel URL ending in /api/integrations/github/webhook
#   Events:       installation, installation_repositories
#
# GITHUB_APP_PRIVATE_KEY accepts either raw PEM with escaped \n or base64 PEM.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new
# Must match the webhook secret configured on the GitHub App.
GITHUB_APP_WEBHOOK_SECRET=

# Better Auth's user-facing base URL. This is what Better Auth uses to build
# its OAuth callback URL — i.e., what GitHub will redirect the browser back
# to after consent. It must match the origin the *user* sees in their address
# bar, not the origin the backend listens on, because the session cookie is
# set on the response origin and only that origin can read it back.
#
# In dev: the user sees the frontend at :5173, Vite proxies /api/* to :3000.
# The cookie has to be set on :5173 so the SPA (also on :5173) can use it,
# so BETTER_AUTH_URL points at :5173. Better Auth builds callback URLs like
# `http://localhost:5173/api/auth/callback/github`; GitHub redirects there;
# Vite proxies the callback to :3000; Better Auth processes it; the response
# (with Set-Cookie) flows back through the proxy to the browser, which
# stores the cookie under origin :5173. Same trick as for /api/me, applied
# to OAuth.
#
# IMPORTANT: this URL must also match the "Authorization callback URL" set
# on the GitHub OAuth app. With this value, register the callback there as:
#   http://localhost:5173/api/auth/callback/github
BETTER_AUTH_URL=http://localhost:5173

# --- Markdown storage -------------------------------------------------------
# The data root for org-scoped markdown storage. Projects live at
# `<PROJECTS_DIR>/orgs/<orgSlug>/projects/<projectSlug>/project.md`. Postgres
# only holds a thin index for fast lookup.
#
# Path can be absolute or relative; relative paths resolve from the repo root
# (where the backend runs). The backend creates the directory on startup if
# it doesn't exist.
PROJECTS_DIR=./storage

# --- Org bootstrap ----------------------------------------------------------
# Repeat-safe first-org bootstrap for local/dev deployments.
BOOTSTRAP_ORG_SLUG=project-project
BOOTSTRAP_ORG_NAME=ProjectProject
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_USERNAME=
