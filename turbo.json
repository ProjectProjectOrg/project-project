{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".github/workflows/ci.yml",
    ".node-version",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "bunfig.toml",
    "tools/oxlint/**",
    "tsconfig.base.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "interactive": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputLogs": "new-only"
    },
    "@pp/frontend#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": [".cache/paraglide/typecheck/**"],
      "outputLogs": "new-only"
    }
  }
}
