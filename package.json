{
  "name": "projectproject",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --filter @projectproject/backend dev",
    "dev:frontend": "bun --filter @projectproject/frontend dev",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^22.10.0",
    "dprint": "^0.54.0",
    "eslint": "^9.20.0",
    "kysely": "0.27.6",
    "typescript": "^5.7.3"
  }
}
