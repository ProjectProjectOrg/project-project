{
  "name": "projectproject",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:backend": "turbo run dev --filter @pp/backend",
    "dev:frontend": "turbo run dev --filter @pp/frontend",
    "dev:gallery": "turbo run dev --filter @pp/ui",
    "dev:db": "docker compose up --wait --wait-timeout 60 postgres",
    "dev:stop": "docker compose stop postgres",
    "dev": "bun run dev:db && turbo run dev --filter @pp/backend --filter @pp/frontend --filter @pp/ui",
    "build": "turbo run build --filter @pp/frontend",
    "test": "bun scripts/test-isolated.ts",
    "test:migrate": "bun run --filter @pp/db db:migrate",
    "typecheck": "turbo run typecheck",
    "lint": "bun lint --no-script --max-warnings=1364",
    "lint:fix": "bun lint --no-script --fix",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "prepare": "effect-tsgo patch",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "check:changed": "bun run fmt:check && bun run lint && bun run typecheck --affected && bun run test",
    "dev:agent": "bun --no-env-file apps/backend/scripts/dev-agent.ts",
    "dev:login": "bun --no-env-file apps/backend/scripts/dev-agent.ts login",
    "dev:agent:clean": "bun --no-env-file apps/backend/scripts/dev-agent.ts clean",
    "dev:agent:prune": "bun --no-env-file apps/backend/scripts/dev-agent.ts prune",
    "dev:agent:stop": "bun --no-env-file apps/backend/scripts/dev-agent.ts stop",
    "dev:agent:trust": "bun --no-env-file apps/backend/scripts/dev-agent.ts trust"
  },
  "devDependencies": {
    "@effect/tsgo": "0.70.0",
    "@interfere/landmines": "0.1.0",
    "@oxlint/plugins": "1.94.0",
    "@shadcn/lint": "0.2.5",
    "@types/node": "^22.10.0",
    "bun": "1.4.5-canary.20261120.1",
    "bun-types": "1.4.5-canary.20261120T140927",
    "effect": "4.0.5",
    "portless": "0.18.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.17",
    "@effect/platform-node-shared": "4.0.5",
    "bun-types": "1.4.5-canary.20261120T140927"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.4"
}
