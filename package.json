{
  "name": "projectproject",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:backend": "turbo run dev --filter @pp/backend",
    "dev:frontend": "turbo run dev --filter @pp/frontend",
    "dev:gallery": "turbo run dev --filter @pp/ui",
    "dev:db": "docker compose up --wait --wait-timeout 60 postgres",
    "dev:stop": "docker compose stop postgres",
    "dev": "bun run dev:db && turbo run dev --filter @pp/backend --filter @pp/frontend --filter @pp/ui",
    "build": "turbo run build --filter @pp/frontend",
    "test": "bun scripts/test-isolated.ts",
    "test:all": "bun run test:lint && bun run test:agent && turbo run test --concurrency=1",
    "test:lint": "bun test tools/oxlint/anti-slop/effect",
    "test:migrate": "bun run --filter @pp/db db:migrate",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint lint:root",
    "lint:fix": "turbo run lint:fix lint:root:fix",
    "lint:root": "oxlint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "lint:root:fix": "oxlint . --fix --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "effect-tsgo patch",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "check:changed": "bun run format:check && bun run lint --affected && bun run typecheck --affected && bun run test --affected",
    "test:db": "vitest run --project db --project \"server-core*\" --project integration-everhour --project integration-jira --project backend --no-file-parallelism",
    "dev:agent": "bun --no-env-file apps/backend/scripts/dev-agent.ts",
    "dev:login": "bun --no-env-file apps/backend/scripts/dev-agent.ts login",
    "dev:agent:clean": "bun --no-env-file apps/backend/scripts/dev-agent.ts clean",
    "dev:agent:prune": "bun --no-env-file apps/backend/scripts/dev-agent.ts prune",
    "dev:agent:stop": "bun --no-env-file apps/backend/scripts/dev-agent.ts stop",
    "dev:agent:trust": "bun --no-env-file apps/backend/scripts/dev-agent.ts trust",
    "test:agent": "bun test apps/backend/scripts/agent"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.1",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^22.10.0",
    "effect": "4.0.5",
    "oxfmt": "0.59.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.18.0",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.3",
    "@effect/platform-node-shared": "4.0.5"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "bun@1.4.4"
}
