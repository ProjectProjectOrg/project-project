{
  "name": "@pp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth-schema": "./src/auth-schema.ts",
    "./jsonRecordset": "./src/jsonRecordset.ts",
    "./projectVisibility": "./src/projectVisibility.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsrs --noEmit",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.5",
    "@pp/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.5",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.5",
    "@effect/vitest": "npm:@voila.dev/effect-bun-test@4.0.4",
    "@types/pg": "^8.20.0",
    "better-auth": "1.7.17",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.5"
  }
}
