    "effect": "4.0.0-rc.116",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/pg": "^8.20.0",
    "better-auth": "1.7.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "vitest": "4.1.11"
  }
