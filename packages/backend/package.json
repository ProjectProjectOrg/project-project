    "@projectproject/shared": "workspace:*",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "effect": "latest",
    "gray-matter": "^4.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
