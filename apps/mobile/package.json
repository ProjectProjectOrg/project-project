{
  "name": "@pp/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_NO_GIT_STATUS=1 expo start --dev-client --port ${PORT:-8081}",
    "prebuild": "EXPO_NO_GIT_STATUS=1 expo prebuild --platform ios",
    "app:ios": "expo run:ios --no-bundler",
    "app:ios:device": "expo run:ios --device --no-bundler",
    "app:ios:standalone": "expo run:ios --configuration Release --no-bundler",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "../../node_modules/.bin/oxlint .",
    "lint:fix": "../../node_modules/.bin/oxlint . --fix",
    "splash": "bun scripts/generate-splash.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.0.0-rc.116",
    "@expo/ui": "~58.0.7",
    "@pp/shared": "workspace:*",
    "@pp/theme": "workspace:*",
    "@shopify/react-native-skia": "2.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-rc.116",
    "expo": "~58.0.0-preview.7",
    "expo-constants": "~58.0.7",
    "expo-crypto": "~58.0.2",
    "expo-dev-client": "~58.0.7",
    "expo-font": "~58.0.2",
    "expo-glass-effect": "~58.0.2",
    "expo-haptics": "~58.0.2",
    "expo-linking": "~58.0.7",
    "expo-router": "~58.0.8",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.1",
    "expo-sqlite": "~58.0.6",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "geist": "^1.7.0",
    "punycode": "^2.3.1",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "uniwind": "^1.12.0",
    "whatwg-url-minimum": "^0.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/culori": "^4.0.1",
    "@types/punycode": "^2.1.4",
    "@types/react": "~19.3.0",
    "culori": "4.0.2",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.34.5",
    "vitest": "4.1.11"
  },
  "enriched-markdown": {
    "enableMath": false
  }
}
