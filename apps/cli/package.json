{
  "name": "@pp/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "pp": "./src/main.ts"
  },
  "scripts": {
    "pp": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --minify --outfile dist/pp",
    "build:release": "sh ../../.github/scripts/build-cli.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun run --bun vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@pp/shared": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/bun": "latest",
    "vitest": "5.0.5"
  }
}
