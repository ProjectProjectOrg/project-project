{
  "name": "@pp/cli",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "pp": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "pp": "bun src/main.ts",
    "build": "bun build src/main.ts --compile --minify --outfile dist/pp",
    "build:release": "sh ../../.github/scripts/build-cli.sh",
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.5",
    "@pp/shared": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "npm:@voila.dev/effect-bun-test@4.0.4",
    "@types/bun": "latest"
  }
}
