{
  "name": "@pp/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --cwd ../.. --env-file=.env --watch \"$PWD/src/main.ts\"",
    "start": "bun --cwd ../.. --env-file=.env \"$PWD/src/main.ts\"",
    "typecheck": "tsc --noEmit && bun run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "bootstrap:org": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/bootstrap-org.ts\"",
    "migrate:orgs": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/migrate-orgs.ts\"",
    "migrate:relayout": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/relayout-data.ts\"",
    "benchmark:ticket-storage": "bun scripts/benchmark-ticket-storage.ts",
    "benchmark:ticket-requests": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/benchmark-ticket-request-paths.ts\"",
    "benchmark:ticket-compare": "bun scripts/benchmark-ticket-compare.ts",
    "ticket-index:rebuild": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/rebuild-ticket-index.ts\"",
    "db:generate": "bun run --cwd ../../packages/db db:generate",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "db:push": "bun run --cwd ../../packages/db db:push",
    "db:studio": "bun run --cwd ../../packages/db db:studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@better-auth/core": "1.7.3",
    "@better-auth/mcp": "1.7.3",
    "@better-auth/oauth-provider": "1.7.3",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/sql-pg": "4.0.0-rc.116",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pp/db": "workspace:*",
    "@pp/server-core": "workspace:*",
    "@pp/shared": "workspace:*",
    "better-auth": "1.7.3",
    "better-call": "1.4.0",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.116",
    "gray-matter": "^4.0.3",
    "pg": "^8.20.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.116",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
