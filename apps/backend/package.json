{
  "name": "@pp/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --cwd \"$PWD/../..\" --env-file=\"$PWD/../../.env\" --watch \"$PWD/src/main.ts\"",
    "start": "bun --cwd ../.. --env-file=.env \"$PWD/src/main.ts\"",
    "typecheck": "effect-tsgo tsrs --noEmit && bun run typecheck:scripts",
    "typecheck:scripts": "effect-tsgo tsrs --noEmit -p tsconfig.scripts.json",
    "bootstrap:org": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/bootstrap-org.ts\"",
    "migrate:relayout": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/relayout-data.ts\"",
    "benchmark:ticket-storage": "bun scripts/benchmark-ticket-storage.ts",
    "benchmark:ticket-requests": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/benchmark-ticket-request-paths.ts\"",
    "benchmark:ticket-compare": "bun scripts/benchmark-ticket-compare.ts",
    "ticket-index:rebuild": "bun --cwd ../.. --env-file=.env \"$PWD/scripts/rebuild-ticket-index.ts\"",
    "db:generate": "bun run --cwd ../../packages/db db:generate",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "db:push": "bun run --cwd ../../packages/db db:push",
    "db:studio": "bun run --cwd ../../packages/db db:studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@better-auth/cimd": "1.7.17",
    "@better-auth/core": "1.7.17",
    "@better-auth/mcp": "1.7.17",
    "@better-auth/oauth-provider": "1.7.17",
    "@better-auth/utils": "0.5.1",
    "@better-fetch/fetch": "1.3.3",
    "@effect/platform-bun": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@pp/access": "workspace:*",
    "@pp/db": "workspace:*",
    "@pp/integration-everhour": "workspace:*",
    "@pp/integration-github": "workspace:*",
    "@pp/integration-jira": "workspace:*",
    "@pp/integration-slack": "workspace:*",
    "@pp/server-core": "workspace:*",
    "@pp/shared": "workspace:*",
    "better-auth": "1.7.17",
    "better-call": "1.4.5",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.0.5",
    "gray-matter": "^4.0.3",
    "pg": "^8.20.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@effect/vitest": "npm:@voila.dev/effect-bun-test@4.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "ajv": "^8.20.0",
    "zod": "4.6.5"
  }
}
