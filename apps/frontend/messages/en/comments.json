{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "comments_composer_placeholder": "Write a comment…",
  "comments_composer_submit": "Comment",
  "comments_created_ticket": "{name} created ticket",
  "comments_delete_confirm": "Delete this comment?",
  "comments_delete_failed": "Failed to delete comment.",
  "comments_discard_confirm": "Discard this comment?",
  "comments_discarding": "Discarding…",
  "comments_edit_button": "Edit",
  "comments_edited_marker": "(edited)",
  "comments_editing_marker": "editing…",
  "comments_failed_message": "Not sent.",
  "comments_failed_retry": "Retry",
  "comments_imported_from_jira": "Imported from Jira",
  "comments_imported_from_projectproject": "Imported from another ProjectProject",
  "comments_load_failed": "Failed to load comments.",
  "comments_mention_card_from": "Comment from {name}",
  "comments_menu_aria_label": "Comment actions",
  "comments_menu_copy_link": "Copy link",
  "comments_menu_copy_markdown": "Copy as markdown",
  "comments_menu_copy_text": "Copy text",
  "comments_menu_copy_thread_markdown": "Copy thread as markdown",
  "comments_menu_create_epic_ticket": "Create ticket in this epic from comment",
  "comments_menu_create_sub_ticket": "Create sub-ticket from comment",
  "comments_menu_create_ticket": "Create ticket from comment",
  "comments_menu_delete": "Delete",
  "comments_menu_discard": "Discard",
  "comments_menu_resolve": "Resolve thread",
  "comments_menu_unresolve": "Reopen thread",
  "comments_reply_placeholder": "Leave a reply…",
  "comments_reply_submit": "Reply",
  "comments_resolve_failed": "Couldn't update the thread.",
  "comments_resolved_at": "Resolved {when}",
  "comments_resolved_by": "Resolved by {name} · {when}",
  "comments_resolved_label": "Resolved",
  "comments_save_button": "Save",
  "comments_save_failed": "Failed to save.",
  "comments_thread_collapse": "Collapse",
  "comments_thread_resolved_folded": [
    {
      "declarations": [
        "input count",
        "input names",
        "local countPlural = count: plural"
      ],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} comment from {names}",
        "countPlural=*": "{count} comments from {names}"
      }
    }
  ],
  "comments_thread_show_earlier": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "Show {count} earlier reply",
        "countPlural=*": "Show {count} earlier replies"
      }
    }
  ],
  "comments_ticket_source": "{author} said in {source}:"
}
