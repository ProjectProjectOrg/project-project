{
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "jsPlugins": [
    {
      "name": "workspace",
      "specifier": "./tools/oxlint/plugin-workspace.js"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    },
    {
      "name": "landmines-types",
      "specifier": "@interfere/landmines/types"
    },
    "@shadcn/lint"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": false
  },
  "plugins": [
    "eslint",
    "import",
    "jsx-a11y",
    "node",
    "oxc",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "settings": {
    "react": {
      "version": "19.0"
    },
    "shadcn": {
      "ui": "@pp/ui",
      "ignoreImports": ["^@pp/ui/(icons|lib|hooks)(/|$)"],
      "themeImports": ["^@pp/ui/"],
      "note": "DESIGN.md holds the design rules and approved exceptions."
    }
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "import/default": "off",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/aria-role": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/control-has-associated-label": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "vitest/no-conditional-expect": "warn",
    "vitest/no-disabled-tests": "warn",
    "vitest/no-standalone-expect": "off",
    "vitest/require-mock-type-parameters": "warn",
    "workspace/no-relative-packages": "error",
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "warn",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "anti-slop-effect/no-global-process-runtime": "error",
    "anti-slop-effect/no-inline-schema-compile": "warn",
    "anti-slop-effect/no-manual-effect-error-tag": "warn",
    "anti-slop-effect/no-manual-effect-runtime-in-tests": "error",
    "anti-slop-effect/no-manual-tag-comparison": "warn",
    "anti-slop-effect/no-manual-tagged-construction": "warn",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "warn",
    "landmines-types/no-explicit-return-types": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/frontend/**/*.{js,jsx,ts,tsx}",
        "apps/videos/**/*.{js,jsx,ts,tsx}",
        "packages/ui/**/*.{js,jsx,ts,tsx}"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/no-unstable-nested-components": [
          "warn",
          {
            "allowAsProps": true
          }
        ],
        "react/hooks": "warn",
        "react/immutability": "warn",
        "react/incompatible-library": "warn",
        "react/preserve-manual-memoization": "warn",
        "react/purity": "warn",
        "react/refs": "warn",
        "react/rule-suppression": "warn",
        "react/set-state-in-effect": "warn",
        "react/set-state-in-render": "warn",
        "react/static-components": "warn",
        "react/syntax": "warn",
        "react/todo": "warn",
        "react/unsupported-syntax": "warn",
        "react/use-memo": "warn",
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "lucide-react",
                "message": "Icons come from @pp/ui/icons (Hugeicons behind one module); add a missing icon there."
              },
              {
                "name": "@pp/shared",
                "importNames": ["canCallProject", "canCallOrg"],
                "message": "Components read permissions through useProjectActor / useOrgActor from @/lib/access; only the atom layer builds actors from the endpoint table."
              }
            ],
            "patterns": [
              {
                "group": ["@testing-library/react", "@testing-library/react/*"],
                "importNames": ["render"],
                "message": "Component rendering tests are not part of this suite. Test logic, atoms, or hooks with renderHook instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/frontend/src/**/*.{ts,tsx}"],
      "rules": {
        "workspace/no-raw-api-query": "error",
        "shadcn/no-arbitrary-values": [
          "error",
          {
            "allow": [
              "layout",
              "transition-*",
              "duration-*",
              "rounded-[inherit]",
              "rounded-t-[inherit]"
            ]
          }
        ],
        "shadcn/no-restyle": [
          "error",
          {
            "allow": [
              "layout",
              "tabular-nums",
              "truncate",
              "line-clamp-*",
              "placeholder:font-sans"
            ],
            "contracts": [
              {
                "pattern": "^(PopoverContent|HoverCardContent|HoverCardFooter|BoardColumns|ConfirmButtonRoot|ListHoverScope|TimelineValues|InputGroupAddon|CommandMenuList|CommandMenuEmpty)$",
                "allow": ["layout", "spacing"]
              },
              {
                "pattern": "^(MiddleTruncate|MarqueeIfOverflow|TextSwap)$",
                "allow": ["layout", "spacing", "color", "typography"]
              },
              {
                "pattern": "^Hitbox$",
                "allow": ["layout", "spacing", "shape"]
              },
              {
                "pattern": "^FluidHoverHighlight$",
                "allow": ["layout", "shape"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/frontend/src/**/*.{ts,tsx}",
        "packages/ui/src/**/*.{ts,tsx}",
        "packages/ui/gallery/src/**/*.{ts,tsx}",
        "packages/ui/docs/**/*.{ts,tsx}"
      ],
      "rules": {
        "workspace/type-scale": "error",
        "eslint/max-lines": [
          "warn",
          {
            "max": 400,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "eslint/max-lines-per-function": [
          "warn",
          {
            "max": 200,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "apps/frontend/src/**/*.{spec,test}.{ts,tsx}",
        "apps/frontend/src/**/*.test-d.{ts,tsx}",
        "packages/ui/src/**/*.{spec,test}.{ts,tsx}",
        "packages/ui/src/**/*.test-d.{ts,tsx}",
        "apps/frontend/src/paraglide/**",
        "apps/frontend/src/routeTree.gen.ts"
      ],
      "rules": {
        "eslint/max-lines": "off",
        "eslint/max-lines-per-function": "off",
        "workspace/type-scale": "off"
      }
    },
    {
      "files": [
        "apps/frontend/src/features/**/commands.ts",
        "apps/frontend/src/features/**/*Commands.ts",
        "apps/frontend/src/features/command-menu/pages.tsx",
        "apps/frontend/src/features/*/components/command-pages/**"
      ],
      "rules": {
        "eslint/max-lines": "off"
      }
    },
    {
      "files": ["packages/ui/src/**"],
      "rules": {
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": [
        "apps/frontend/src/features/auth/components/LoginPage.tsx",
        "apps/frontend/src/features/auth/components/ProviderMarks.tsx",
        "packages/ui/src/editor/figma/figma-chip.tsx"
      ],
      "rules": {
        "shadcn/no-raw-colors": "off"
      }
    },
    {
      "files": ["apps/frontend/src/api/**/*.{ts,tsx}"],
      "rules": {
        "workspace/no-raw-api-query": "off"
      }
    },
    {
      "files": ["apps/frontend/src/features/*/atoms/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@testing-library/react", "@testing-library/react/*"],
                "importNames": ["render"],
                "message": "Component rendering tests are not part of this suite. Test logic, atoms, or hooks with renderHook instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.{spec,test}.{js,jsx,ts,tsx}"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/require-to-throw-message": "off",
        "vitest/valid-expect": "off",
        "landmines-testing/no-fixed-sleep": [
          "error",
          {
            "allow": {
              "packages/integration-slack/src/socketMode.test.ts": 1
            }
          }
        ],
        "landmines-testing/no-flake-masking": [
          "error",
          {
            "allow": {
              "apps/backend/scripts/agent/migration.blocked.test.ts": 1,
              "apps/backend/scripts/agent/migration.startup.test.ts": 1,
              "apps/backend/src/jira/Migrations.commands.test.ts": 15,
              "apps/backend/src/jira/WorkflowRestart.postgres.test.ts": 1,
              "apps/backend/src/slack/Slack.postgres.test.ts": 3,
              "packages/integration-slack/src/socketMode.test.ts": 1
            }
          }
        ],
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@testing-library/react", "@testing-library/react/*"],
                "importNames": ["render"],
                "message": "Component rendering tests are not part of this suite. Test logic, atoms, or hooks with renderHook instead."
              },
              {
                "group": [
                  "react-dom",
                  "react-dom/*",
                  "react-test-renderer",
                  "react-test-renderer/*"
                ],
                "message": "Component rendering tests are not part of this suite. Test logic, atoms, or hooks with renderHook instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/backend/src/projectVisibility.test.ts",
        "apps/backend/src/jira/**/*.test.ts",
        "packages/integration-jira/src/**/*.test.ts",
        "apps/backend/src/slack/Slack.postgres.test.ts"
      ],
      "rules": {
        "anti-slop-effect/no-manual-effect-runtime-in-tests": "warn"
      }
    },
    {
      "files": ["packages/integration-*/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@pp/server-core",
                  "@pp/server-core/**",
                  "**/server-core/**",
                  "**/apps/**"
                ],
                "message": "Integrations consume PP capabilities through their host services; the backend supplies its implementation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/server-core/src/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@pp/integration-*",
                  "@pp/integration-*/**",
                  "**/integration-*/**"
                ],
                "message": "Core records provider-neutral events and must not depend on integration packages."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".superpowers/**",
    ".windsurf/**",
    "opensrc/**",
    "tools/oxlint/anti-slop/**",
    "apps/cli/vendor/**",
    "node_modules",
    "bun.lock",
    "*.tsbuildinfo",
    "**/routeTree.gen.ts",
    "**/*.md"
  ]
}
