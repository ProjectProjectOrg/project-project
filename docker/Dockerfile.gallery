# Gallery image: nginx serving the component gallery (packages/ui/gallery),
# a static site with no backend.
#
# CI builds the gallery before this image, so it copies the output from
# packages/ui/gallery/dist. Build it locally with
# `bun run --cwd packages/ui build-gallery` first.

FROM nginx:1.30.7-alpine
COPY packages/ui/gallery/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' \
      -o -name '*.svg' -o -name '*.json' -o -name '*.md' -o -name '*.txt' \) -size +1k \
      -exec gzip -9 -k {} +
COPY docker/nginx.gallery.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
  CMD wget --quiet --output-document=- http://127.0.0.1/ > /dev/null || exit 1
