# Backend image — Bun runtime serving the HttpApi on :3000.
#
# Multi-stage:
#   1. `deps` installs the workspace's dependencies (cached layer).
#   2. `runtime` copies source + `node_modules` and runs `bun src/main.ts`.
#
# We don't compile to a single file with `bun build` — Bun runs TS natively,
# and the source layout is small enough that this stays fast. If startup
# ever becomes an issue, swap to `bun build --compile` here.

FROM oven/bun:1.4.2-slim AS bun

FROM node:24.15.0-bookworm-slim AS deps
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

# Copy only manifests first so dep install is cache-friendly when source
# changes but lockfile doesn't.
COPY package.json bun.lock* bun.lockb* tsconfig.base.json ./
COPY packages/db/package.json ./packages/db/
COPY packages/server-core/package.json ./packages/server-core/
COPY packages/shared/package.json ./packages/shared/
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/

# Install only what backend + shared need at runtime. `--frozen-lockfile`
# fails CI if the lockfile drifts from package.jsons.
RUN bun install --frozen-lockfile

FROM oven/bun:1.4.2-slim AS runtime
WORKDIR /app

# Bring deps over and then layer in source. Frontend source is omitted since
# this image only serves the backend HTTP API. Bun's isolated linker keeps
# each workspace's dependency links beside that workspace.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --from=deps /app/packages/server-core/node_modules ./packages/server-core/node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/apps/backend/node_modules ./packages/backend/node_modules
COPY package.json bun.lock* bun.lockb* tsconfig.base.json ./
COPY packages/db ./packages/db
COPY packages/server-core ./packages/server-core
COPY packages/shared ./packages/shared
COPY apps/backend ./packages/backend
COPY docker/entrypoint.backend.sh /usr/local/bin/entrypoint.backend.sh

# Markdown data root is bind-mounted at runtime; org-scoped projects live
# at <PROJECTS_DIR>/orgs/<orgSlug>/projects/<projectSlug>/. We still create
# the path so PROJECTS_DIR resolution finds something on first boot.
RUN mkdir -p /data
RUN chmod +x /usr/local/bin/entrypoint.backend.sh
ENV PROJECTS_DIR=/data
ENV NODE_ENV=production

EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
  CMD ["bun", "-e", "const response = await fetch('http://127.0.0.1:3000/api/health'); if (!response.ok) process.exit(1)"]
ENTRYPOINT ["/usr/local/bin/entrypoint.backend.sh"]
CMD ["bun", "run", "packages/backend/src/main.ts"]
