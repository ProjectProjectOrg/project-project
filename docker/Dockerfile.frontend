# Frontend image — nginx serving the Vite build, proxying /api to the
# backend container.
#
# CI's Build job already runs Vite, so this image copies its output from
# apps/frontend/dist instead of building again. Build it locally with
# `bun run --cwd apps/frontend build` first.

FROM nginx:1.30.7-alpine
COPY apps/frontend/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' \
      -o -name '*.svg' -o -name '*.json' -o -name '*.webmanifest' \) -size +1k \
      -exec gzip -9 -k {} +
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx.locations /etc/nginx/app.locations

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
  CMD wget --quiet --output-document=- http://127.0.0.1/ > /dev/null || exit 1
