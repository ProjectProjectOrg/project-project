# Frontend image — nginx serving the Vite build, proxying /api to the
# backend container.
#
# Two stages: `build` runs Vite, `runtime` is plain nginx with the dist
# folder copied in plus our nginx config that handles SPA fallback and
# the /api/* proxy.

FROM oven/bun:1.4.4-slim AS bun

FROM node:24.15.0-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app

COPY package.json bun.lock* bun.lockb* tsconfig.base.json ./
COPY packages/access/package.json ./packages/access/
COPY packages/db/package.json ./packages/db/
COPY packages/integration-everhour/package.json ./packages/integration-everhour/
COPY packages/integration-github/package.json ./packages/integration-github/
COPY packages/integration-slack/package.json ./packages/integration-slack/
COPY packages/server-core/package.json ./packages/server-core/
COPY packages/shared/package.json ./packages/shared/
COPY apps/backend/package.json ./apps/backend/
COPY apps/frontend/package.json ./apps/frontend/
RUN bun install --frozen-lockfile

COPY packages/access ./packages/access
COPY packages/shared ./packages/shared
COPY apps/frontend ./apps/frontend

# Vite reads `import.meta.env.*` at build time. The frontend itself talks
# to a same-origin /api, so no API-URL env is needed. Note the flag order:
# `bun run --cwd <dir> <script>` runs the script in that workspace;
# `bun --cwd <dir> run <script>` is a different command that just lists
# scripts. We learned this the noisy way.
RUN bun run --cwd apps/frontend build

RUN find apps/frontend/dist -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' \
      -o -name '*.svg' -o -name '*.json' -o -name '*.webmanifest' \) -size +1k \
      -exec gzip -9 -k {} +

FROM nginx:1.30.6-alpine AS runtime
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx.locations /etc/nginx/app.locations

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
  CMD wget --quiet --output-document=- http://127.0.0.1/ > /dev/null || exit 1
